# Шаблон налаштувань. Скопіюйте його у файл .env і заповніть значення:
#     cp .env.example .env
#
# Справжній .env у git не потрапляє — так і має бути.
# НІКОЛИ не вписуйте ключі в цей файл: він відстежується git-ом.


# --- API ключі -------------------------------------------------------------

# https://aistudio.google.com/api-keys -> "Create API key"
# Вставляйте без лапок: GEMINI_API_KEY=AIza...
GEMINI_API_KEY=

# https://pixabay.com/api/docs/ -> розділ "Search Images" -> "Your API key"
PIXABAY_KEY=


# --- Django ----------------------------------------------------------------

# Локально: True. На сервері обов'язково False.
DEBUG=True

# Локально можна лишити порожнім — підставиться ключ для розробки.
# На сервері обов'язковий, інакше Django не стартує. Згенерувати новий:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Домени, з яких приймати запити. Через кому, без http://
# Локально: localhost,127.0.0.1
# На сервері: carebridge.cc,www.carebridge.cc
ALLOWED_HOSTS=localhost,127.0.0.1

# Звідки дозволені запити з браузера. Через кому, зі схемою http:// чи https://
# На сервері: https://carebridge.cc,https://www.carebridge.cc
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# --- PostgreSQL ------------------------------------------------------------

DB_NAME=carebridge
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
